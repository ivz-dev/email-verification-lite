# --- HTTP server ---
# Port the API listens on.
PORT=3000
# Interface to bind. 0.0.0.0 = all interfaces; 127.0.0.1 = localhost only.
HOST=0.0.0.0

# --- Verification ---
# Timeout for DNS (MX/A/AAAA) lookups, in milliseconds.
DNS_TIMEOUT_MS=5000
# Maximum number of addresses accepted by POST /verify/batch.
MAX_BATCH_SIZE=100

# --- Authentication ---
# Comma-separated list of accepted API keys. Clients must send one via the
# 'X-API-Key' header or 'Authorization: Bearer <key>'.
# Leave EMPTY to disable auth (local development only).
# Generate a strong key, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=changeme-key-1,changeme-key-2
